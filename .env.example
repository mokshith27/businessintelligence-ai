# ============================================================
# BusinessIntelligence.ai — Environment Configuration
# ------------------------------------------------------------
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in the values for your own account.
# 3. NEVER commit the real `.env` file to version control.
# ============================================================

# ------------------------------------------------------------
# PRIMARY LLM
# ------------------------------------------------------------
# Provider used for narrative generation.
# Supported: groq | openrouter | openai | anthropic
LLM_PROVIDER=groq

# Model identifier for the primary provider.
LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------
# FALLBACK MODELS
# ------------------------------------------------------------
# Comma-separated list of provider:model candidates tried when
# the primary model fails.
# Example: openrouter:openrouter/free
LLM_FALLBACKS=openrouter:openrouter/free

# ------------------------------------------------------------
# API KEYS
# ------------------------------------------------------------
# Only the keys for your chosen providers are required.
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------
# GENERATION SETTINGS
# ------------------------------------------------------------
# Maximum tokens per generated narrative.
LLM_MAX_OUTPUT_TOKENS=800

# Sampling temperature. Low values keep narratives deterministic.
LLM_TEMPERATURE=0.1

# Reasoning effort hint: low | medium | high
LLM_REASONING_EFFORT=low

# Verbose LLM debug logging: true | false
LLM_DEBUG=true

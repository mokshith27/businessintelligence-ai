# ============================================================
# BusinessIntelligence.ai — Environment Configuration
# ------------------------------------------------------------
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in the values for your own setup.
# 3. NEVER commit the real `.env` file to version control.
# ============================================================

# ------------------------------------------------------------
# PRIMARY LLM PROVIDER
# ------------------------------------------------------------
# Provider used for narrative generation.
# Supported: local | groq | openrouter | openai | anthropic
#
#   local      -> local OpenAI-compatible server (Ollama default),
#                 no API key, no cloud calls.
#   groq       -> Groq cloud (fast, generous free tier).
#   openrouter -> OpenRouter gateway to many models.
LLM_PROVIDER=local

# Model identifier for the primary provider.
#   local      -> an Ollama model tag, e.g. qwen3:1.7b
#   groq       -> e.g. openai/gpt-oss-120b
#   openrouter -> e.g. openrouter/free
LLM_MODEL=qwen3:1.7b

# ------------------------------------------------------------
# FALLBACK MODELS
# ------------------------------------------------------------
# Comma-separated list of provider:model candidates tried when
# the primary model fails.
# Example: LLM_FALLBACKS=local:qwen3:4b,openrouter:openrouter/free
LLM_FALLBACKS=local:qwen3:4b,local:qwen3:8b

# ------------------------------------------------------------
# LOCAL PROVIDER SETTINGS (used when LLM_PROVIDER=local)
# ------------------------------------------------------------
# Ollama default endpoint. LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434/v1
# "ollama" -> native /api/chat with Qwen3 thinking disabled
# "openai" -> generic OpenAI-compatible /v1/chat/completions
LLM_LOCAL_API_MODE=ollama
# Context window for the local model. IMPORTANT: the narrative
# prompts are ~4,000 tokens; a window of 2048 TRUNCATES the
# prompt and cuts off the output-format instructions, causing
# "contains no required sections" failures. Use 8192 or higher.
LLM_LOCAL_NUM_CTX=8192
# Sampling temperature used ONLY by the local provider.
# Qwen3 non-thinking mode is tuned for ~0.6; 0.1 makes it terse.
LLM_LOCAL_TEMPERATURE=0.6
# Repetition penalty for the local model (prevents Qwen3 loop stalls).
LLM_LOCAL_REPEAT_PENALTY=1.3

# ------------------------------------------------------------
# API KEYS
# ------------------------------------------------------------
# Only the keys for your chosen providers are required.
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
# Leave unset when running fully local.
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# GENERATION SETTINGS
# ------------------------------------------------------------
# Maximum tokens per generated narrative.
LLM_MAX_OUTPUT_TOKENS=1400

# Sampling temperature. Low values keep narratives deterministic.
LLM_TEMPERATURE=0.1

# Reasoning effort hint: low | medium | high
LLM_REASONING_EFFORT=low

# Max generations per candidate when the section cleaner rejects output.
LLM_CLEAN_RETRIES=2

# Verbose LLM debug logging: true | false
LLM_DEBUG=true
